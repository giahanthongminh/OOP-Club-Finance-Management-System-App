<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.ProjectsController"
      prefWidth="1440" prefHeight="1024">

    <VBox prefWidth="280" prefHeight="1024"
          style="-fx-background-color: #191919; -fx-padding: 48 28 48 28;">

        <Label text="Mony"
               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: 800;"/>

        <VBox spacing="8" style="-fx-padding: 40 0 0 0;">
            <Button text="Projects"
                    style="-fx-background-color: #299D91; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12 16 12 16; -fx-background-radius: 4; -fx-alignment: CENTER_LEFT;"/>
            <Button text="Transactions"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 16px; -fx-padding: 12 16 12 16; -fx-background-radius: 4; -fx-alignment: CENTER_LEFT;"/>
        </VBox>

        <Region prefHeight="500"/>

        <VBox spacing="16">
            <Button text="Logout"
                    style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 16 12 16; -fx-background-radius: 4; -fx-alignment: CENTER_LEFT;"/>
            <VBox style="-fx-padding: 16 0 0 0; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
                <Label fx:id="sidebarUsername" text="User"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                <Label text="View profile" style="-fx-text-fill: #666666; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </VBox>

    <VBox prefWidth="1160" prefHeight="1024" style="-fx-background-color: #F5F5F0;">

        <HBox alignment="CENTER_LEFT" prefHeight="72"
              style="-fx-background-color: white; -fx-padding: 0 32 0 32; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
            <VBox>
                <Label text="Hello!"
                       style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                <Label fx:id="usernameLabel" text=""
                       style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
            </VBox>
            <Region prefWidth="700"/>
            <TextField promptText="Search here..." prefWidth="240" prefHeight="36"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0; -fx-font-size: 14px;"/>
        </HBox>

        <VBox spacing="24" style="-fx-padding: 32;">

            <HBox alignment="CENTER_LEFT">
                <Label text="Projects"
                       style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                <Region prefWidth="500"/>
                <Button fx:id="createProjectBtn" text="+ Create Project"
                        onAction="#handleCreateProject"
                        style="-fx-background-color: #299D91; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 10 20 10 20; -fx-background-radius: 8;"/>
            </HBox>

            <HBox spacing="16">
                <VBox prefWidth="220" spacing="4"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 24 20 24;">
                    <Label text="Total Balance" style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                    <Label text="\$12,400.00" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                </VBox>
                <VBox prefWidth="220" spacing="4"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 24 20 24;">
                    <Label text="Total Spent" style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                    <Label text="\$4,200.00" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                </VBox>
                <VBox prefWidth="220" spacing="4"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 24 20 24;">
                    <Label text="Remaining Balance" style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                    <Label text="\$8,200.00" style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #299D91;"/>
                </VBox>
            </HBox>

            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="24"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 24 20 24;">
                    <VBox prefWidth="800" spacing="4">
                        <Label text="Project 1" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                        <HBox spacing="24">
                            <Label text="Budget: $5,000" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Spent: $1,200" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Pots: 3" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Transactions: 8" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                        </HBox>
                    </VBox>
                    <Button text="Open" style="-fx-background-color: #299D91; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 6;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="24"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20 24 20 24;">
                    <VBox prefWidth="800" spacing="4">
                        <Label text="Project 2" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #191919;"/>
                        <HBox spacing="24">
                            <Label text="Budget: $3,000" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Spent: $900" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Pots: 2" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                            <Label text="Transactions: 5" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                        </HBox>
                    </VBox>
                    <Button text="Open" style="-fx-background-color: #299D91; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 6;"/>
                </HBox>
            </VBox>

        </VBox>
    </VBox>
</HBox>